# Copie este arquivo para ".env.local" e preencha com seus valores reais.
# Nenhuma dessas variáveis é obrigatória para rodar o site localmente.

# Se você integrar o envio de e-mail em app/api/contato/route.ts (ex.: Resend)
RESEND_API_KEY=

# Os IDs de Google Analytics e Meta Pixel ficam em lib/constants.ts (SITE.googleAnalyticsId
# e SITE.metaPixelId), não aqui — mas se preferir usar variáveis de ambiente, adapte o código
# em components/Analytics.tsx para ler de process.env.
